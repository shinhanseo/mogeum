{
  "name": "mogeum",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run check:tasting && npm test",
    "test:menu-quality": "tsx --test tests/menu-result.test.ts tests/product-catalog.test.ts tests/menu.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:storage": "tsx --test tests/storage-api.test.ts tests/menu-api.test.ts tests/native-probe-cleanup.test.ts tests/cellar-api.test.ts tests/next-drinks-api.test.ts",
    "check:tasting": "tsx scripts/check-tasting-contract.ts && tsx scripts/build-taste-features.ts --check",
    "build:menu-function": "tsx scripts/build-menu-function.ts",
    "test:menu-deploy": "tsx scripts/verify-menu-function.ts",
    "build:discovery-function": "tsx scripts/build-next-drinks-function.ts",
    "test:discovery-deploy": "tsx scripts/verify-next-drinks-function.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-kr": "0.4.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.19",
    "expo-asset": "58.0.18",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "postgres": "3.4.9",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
