{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/taste-summary/index.ts",
    "supabase/functions/taste-summary/provider.ts",
    "supabase/functions/product-research/provider.ts",
    "supabase/functions/product-research/service.ts",
    "supabase/functions/product-research/extract.ts",
    "supabase/functions/product-research/index.ts",
    "supabase/functions/menu-recommend/index.ts",
    "supabase/functions/next-drinks/index.ts",
    "supabase/functions/delete-account/index.ts",
    "supabase/functions/provider-credentials/index.ts",
    "supabase/tests/**",
    "artifacts/**",
    "supabase/functions/next-drinks/select.ts",
    "supabase/functions/next-drinks/weekly-service.ts",
    "supabase/functions/menu-recommend/select.ts",
    "supabase/functions/menu-recommend/selection-service.ts"
  ]
}
