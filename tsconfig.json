{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/taste-summary/index.ts",
    "supabase/functions/taste-summary/provider.ts",
    "supabase/functions/menu-recommend/index.ts",
    "supabase/functions/next-drinks/index.ts",
    "supabase/functions/delete-account/index.ts"
  ]
}
